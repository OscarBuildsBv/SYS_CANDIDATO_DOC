@startuml
title Sistema SYS-SISTEMA-ABOGADO\nDiagrama de Secuencia - Registro de Consultas

skinparam backgroundColor white
skinparam shadowing false

skinparam sequence {
    ArrowColor black
    LifeLineBorderColor black
    LifeLineBackgroundColor white
    ParticipantBorderColor black
    ParticipantBackgroundColor white
    ParticipantFontColor black
    ActorBorderColor black
    ActorBackgroundColor white
    ActorFontColor black
}

skinparam defaultFontColor black

actor Usuario

participant Frontend
participant "API Gateway" as API
participant "Servicio de Consultas" as Consultas
database "Base de Datos" as BD

== Registro de consulta ==

Usuario -> Frontend : Completa formulario
Frontend -> API : Enviar consulta

API -> Consultas : Registrar consulta

Consultas -> BD : Guardar información
BD --> Consultas : Confirmación

Consultas --> API : Consulta registrada
API --> Frontend : Respuesta exitosa

Frontend --> Usuario : Mostrar confirmación

@enduml