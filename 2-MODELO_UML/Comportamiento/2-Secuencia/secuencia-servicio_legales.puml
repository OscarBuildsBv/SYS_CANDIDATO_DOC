@startuml
title Sistema SYS-SISTEMA-ABOGADO\nDiagrama de Secuencia - Solicitud y Gestión de Citas

skinparam backgroundColor white
skinparam shadowing false

skinparam sequence {
    ArrowColor black
    LifeLineBorderColor black
    LifeLineBackgroundColor white
    ParticipantBorderColor black
    ParticipantBackgroundColor white
    ParticipantFontColor black
    ActorBorderColor black
    ActorBackgroundColor white
    ActorFontColor black
}

skinparam defaultFontColor black

actor Visitante
actor Administrador

participant "Sistema Web" as SW
participant "Módulo de Citas" as MC
participant "Base de Datos" as BD

== Solicitud de cita ==

Visitante -> SW : Accede al portal

SW --> Visitante : Mostrar servicios

Visitante -> SW : Solicitar cita

SW --> Visitante : Mostrar formulario

Visitante -> SW : Enviar datos

SW -> MC : Validar solicitud

MC -> BD : Registrar cita
BD --> MC : Confirmación

MC --> SW : Cita registrada

SW --> Visitante : Mostrar confirmación

== Gestión administrativa ==

Administrador -> SW : Acceder al panel

SW -> MC : Solicitar citas

MC -> BD : Consultar registros
BD --> MC : Lista de citas

MC --> SW : Mostrar información

SW --> Administrador : Panel actualizado

Administrador -> SW : Aprobar o reprogramar cita

SW -> MC : Actualizar estado

MC -> BD : Guardar cambios
BD --> MC : Confirmación

MC --> SW : Estado actualizado

SW --> Administrador : Notificación de éxito

@enduml