@startuml
title Sistema SYS-SISTEMA-ABOGADO\nDiagrama de Secuencia - Gestión de Citas

skinparam backgroundColor white
skinparam shadowing false

skinparam sequence {
    ArrowColor black
    LifeLineBorderColor black
    LifeLineBackgroundColor white
    ParticipantBorderColor black
    ParticipantBackgroundColor white
    ParticipantFontColor black
    ActorBorderColor black
    ActorBackgroundColor white
    ActorFontColor black
}

skinparam defaultFontColor black

actor Cliente

participant Frontend
participant "API Gateway" as API
participant "Servicio de Citas" as Citas
database "Base de Datos" as BD

== Registro de cita ==

Cliente -> Frontend : Solicita agendar cita
Frontend -> API : Enviar datos de cita

API -> Citas : Registrar cita

Citas -> BD : Guardar cita
BD --> Citas : Confirmación

Citas --> API : Cita registrada
API --> Frontend : Generar comprobante

Frontend --> Cliente : Mostrar confirmación

@enduml