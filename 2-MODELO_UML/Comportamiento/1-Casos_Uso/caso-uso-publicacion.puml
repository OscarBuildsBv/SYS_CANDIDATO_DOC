@startuml

skinparam backgroundColor #1E1E1E
skinparam packageStyle folder
skinparam shadowing false
skinparam actorStyle awesome

skinparam package {
    BackgroundColor #1E1E1E
    BorderColor #D4A017
    RoundCorner 10
}

skinparam usecase {
    BackgroundColor #2B2B2B
    BorderColor #D4A017
    FontColor #F5C542
    ArrowColor #D4A017
}

skinparam actor {
    FontColor #F5C542
    BorderColor #D4A017
}

skinparam ArrowColor #D4A017
skinparam defaultFontColor #F5C542

left to right direction

actor Abogado
actor Administrador

package "Sistema Web de Publicaciones" {

  (Iniciar sesión) as UC1
  (Crear publicación) as UC2
  (Escribir texto) as UC3
  (Subir imagen) as UC4
  (Visualizar vista previa) as UC5
  (Publicar contenido) as UC6
  (Editar publicación) as UC7
  (Eliminar publicación) as UC8

}

Abogado --> UC1
Abogado --> UC2
Abogado --> UC7

Administrador --> UC8

UC2 .> UC3 : <<include>>
UC2 .> UC4 : <<include>>
UC2 .> UC5 : <<include>>
UC2 .> UC6 : <<include>>

legend right
  |<#D4A017> Actores |
  |<#F5C542> Funcionalidades |
  |Abogado| Crear y gestionar publicaciones |
  |Administrador| Eliminar publicaciones |
  |UC2| Incluye texto, imagen, vista previa y publicación |
endlegend

@enduml