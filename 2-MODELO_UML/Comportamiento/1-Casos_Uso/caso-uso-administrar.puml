@startuml
title SYS-SISTEMA-ABOGADO - UC: Administrar Citas

left to right direction

skinparam backgroundColor #1E1E1E
skinparam packageStyle folder
skinparam shadowing false
skinparam actorStyle awesome

skinparam package {
    BackgroundColor #1E1E1E
    BorderColor #D4A017
    RoundColor #D4A017
    RoundCorner 10
}

skinparam usecase {
    BackgroundColor #2B2B2B
    BorderColor #D4A017
    FontColor #F5C542
    ArrowColor #D4A017
}

skinparam actor {
    FontColor #F5C542
    BorderColor #D4A017
}

skinparam ArrowColor #D4A017
skinparam defaultFontColor #F5C542

actor Cliente as C
actor Abogado as B
actor Administrador as A

rectangle "Sistema SYS-SISTEMA-ABOGADO" {

    usecase "Solicitar cita" as UC1
    usecase "Consultar disponibilidad" as UC2
    usecase "Confirmar cita" as UC3
    usecase "Reprogramar cita" as UC4
    usecase "Cancelar cita" as UC5
    usecase "Ver calendario de citas" as UC6
    usecase "Gestionar agenda" as UC7
    usecase "Registrar resultado de cita" as UC8
    usecase "Notificar cita" as UC9
}

C --> UC1
C --> UC4
C --> UC5

B --> UC3
B --> UC6
B --> UC8

A --> UC7
A --> UC6

UC1 --> UC2
UC3 --> UC9
UC4 --> UC2
UC5 --> UC9

@enduml